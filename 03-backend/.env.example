# Database connection string:
# Local dev default uses SQLite (zero setup):
DATABASE_URL=sqlite:///./manabi_prep.db

# PostgreSQL (Docker Compose / hosted):
# DATABASE_URL=postgresql+psycopg://manabi:manabi@localhost:5432/manabi_prep

# Comma-separated CORS origins allowed to talk to FastAPI
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
